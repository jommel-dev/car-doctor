generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SERVICE_ADVISOR
  TECHNICIAN
  CASHIER
}

model Customer {
  id          Int       @id @default(autoincrement())
  name        String
  contactInfo String?   @map("contact_info")
  createdAt   DateTime  @default(now()) @map("created_at")
  vehicles    Vehicle[]
  invoices    Invoice[]
  receivables AccountReceivable[]

  @@map("customers")
}

model Vehicle {
  id          Int              @id @default(autoincrement())
  customerId  Int              @map("customer_id")
  plateNumber String           @unique @map("plate_number")
  make        String
  model       String
  engineInfo  String?          @map("engine_info")
  chassisInfo String?          @map("chassis_info")
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobOrders   JobOrder[]
  history     ServiceHistory[]

  @@index([customerId])
  @@map("vehicles")
}

model Technician {
  id                 Int              @id @default(autoincrement())
  name               String
  contactInfo        String?          @map("contact_info")
  performanceMetrics Json?            @map("performance_metrics")
  jobOrders          JobOrder[]

  @@map("technicians")
}

model JobOrder {
  id           Int              @id @default(autoincrement())
  vehicleId    Int              @map("vehicle_id")
  technicianId Int?             @map("technician_id")
  description  String
  status       String           @default("PENDING")
  createdAt    DateTime         @default(now()) @map("created_at")
  completedAt  DateTime?        @map("completed_at")
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  technician   Technician?      @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  services     ServiceHistory[]
  sales        Sale[]
  invoices     Invoice[]

  @@index([vehicleId])
  @@index([technicianId])
  @@map("job_orders")
}

model ServiceHistory {
  id            Int       @id @default(autoincrement())
  vehicleId     Int       @map("vehicle_id")
  jobOrderId    Int       @map("job_order_id")
  partsReplaced String?   @map("parts_replaced")
  notes         String?
  serviceDate   DateTime  @map("service_date")
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobOrder      JobOrder  @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([jobOrderId])
  @@map("service_history")
}

model Supplier {
  id           Int               @id @default(autoincrement())
  name         String
  contactInfo  String?           @map("contact_info")
  paymentTerms String?           @map("payment_terms")
  inventory    Inventory[]
  purchases    Purchase[]
  payables     AccountPayable[]

  @@map("suppliers")
}

model Inventory {
  id                Int       @id @default(autoincrement())
  partName          String    @map("part_name")
  stockQty          Int       @default(0) @map("stock_qty")
  lowStockThreshold Int       @default(5) @map("low_stock_threshold")
  supplierId        Int?      @map("supplier_id")
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sales             Sale[]

  @@index([supplierId])
  @@map("inventory")
}

model Purchase {
  id         Int              @id @default(autoincrement())
  supplierId Int              @map("supplier_id")
  amount     Decimal          @db.Decimal(12, 2)
  createdAt  DateTime         @default(now()) @map("created_at")
  supplier   Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  payables   AccountPayable[]

  @@index([supplierId])
  @@map("purchases")
}

model Invoice {
  id         Int                 @id @default(autoincrement())
  customerId Int                 @map("customer_id")
  jobOrderId Int?                @map("job_order_id")
  totalAmount Decimal            @db.Decimal(12, 2) @map("total_amount")
  status     String              @default("UNPAID")
  issuedAt   DateTime            @default(now()) @map("issued_at")
  paidAt     DateTime?           @map("paid_at")
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobOrder   JobOrder?           @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  sales      Sale[]
  receivable AccountReceivable?

  @@index([customerId])
  @@index([jobOrderId])
  @@map("invoices")
}

model Sale {
  id          Int        @id @default(autoincrement())
  jobOrderId  Int?       @map("job_order_id")
  inventoryId Int?       @map("inventory_id")
  invoiceId   Int?       @map("invoice_id")
  amount      Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now()) @map("created_at")
  jobOrder    JobOrder?  @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([jobOrderId])
  @@index([inventoryId])
  @@index([invoiceId])
  @@map("sales")
}

model AccountReceivable {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  invoiceId  Int       @unique @map("invoice_id")
  balance    Decimal   @db.Decimal(12, 2)
  dueDate    DateTime  @map("due_date")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("accounts_receivable")
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("expenses")
}

model AccountPayable {
  id         Int       @id @default(autoincrement())
  supplierId Int       @map("supplier_id")
  purchaseId Int       @map("purchase_id")
  balance    Decimal   @db.Decimal(12, 2)
  dueDate    DateTime  @map("due_date")
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([purchaseId])
  @@map("accounts_payable")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}
